# Parameters for the PRODUCTION environment.
# Format: ParameterKey=Value (one per line, no spaces around "=").
# deploy.sh automatically passes only the keys a given template declares.
EnvironmentName=prod
VpcCidr=10.40.0.0/16
PublicSubnet1Cidr=10.40.1.0/24
PublicSubnet2Cidr=10.40.2.0/24
AppSubnet1Cidr=10.40.11.0/24
AppSubnet2Cidr=10.40.12.0/24
DbSubnet1Cidr=10.40.21.0/24
DbSubnet2Cidr=10.40.22.0/24
HighAvailabilityNat=true
DbInstanceClass=db.t4g.medium
DbAllocatedStorage=100
MultiAz=true
BackupRetentionDays=14
LogRetentionDays=90
FrontendDesiredCount=2
BackendDesiredCount=2
TaskCpu=1024
TaskMemory=2048
MaxTaskCount=10
InstanceType=t3.medium
MinSize=2
MaxSize=6
DesiredCapacity=2
AlertEmail=change-me@example.com
