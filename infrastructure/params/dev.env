# Parameters for the DEV environment.
# Format: ParameterKey=Value (one per line, no spaces around "=").
# deploy.sh automatically passes only the keys a given template declares.
EnvironmentName=dev
VpcCidr=10.20.0.0/16
PublicSubnet1Cidr=10.20.1.0/24
PublicSubnet2Cidr=10.20.2.0/24
AppSubnet1Cidr=10.20.11.0/24
AppSubnet2Cidr=10.20.12.0/24
DbSubnet1Cidr=10.20.21.0/24
DbSubnet2Cidr=10.20.22.0/24
HighAvailabilityNat=false
DbInstanceClass=db.t3.micro
DbAllocatedStorage=20
MultiAz=false
BackupRetentionDays=1
LogRetentionDays=7
FrontendDesiredCount=1
BackendDesiredCount=1
TaskCpu=512
TaskMemory=1024
MaxTaskCount=3
InstanceType=t3.small
MinSize=1
MaxSize=2
DesiredCapacity=1
AlertEmail=change-me@example.com
