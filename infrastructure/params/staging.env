# Parameters for the STAGING environment.
# Format: ParameterKey=Value (one per line, no spaces around "=").
# deploy.sh automatically passes only the keys a given template declares.
EnvironmentName=staging
VpcCidr=10.30.0.0/16
PublicSubnet1Cidr=10.30.1.0/24
PublicSubnet2Cidr=10.30.2.0/24
AppSubnet1Cidr=10.30.11.0/24
AppSubnet2Cidr=10.30.12.0/24
DbSubnet1Cidr=10.30.21.0/24
DbSubnet2Cidr=10.30.22.0/24
HighAvailabilityNat=false
DbInstanceClass=db.t3.micro
DbAllocatedStorage=20
MultiAz=false
BackupRetentionDays=7
LogRetentionDays=30
FrontendDesiredCount=2
BackendDesiredCount=2
TaskCpu=512
TaskMemory=1024
MaxTaskCount=6
InstanceType=t3.small
MinSize=1
MaxSize=4
DesiredCapacity=2
AlertEmail=dixitkomal133@gmail.com
